# =============================================================================
# MailFlow — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/mailflow
DB_USERNAME=mailflow
DB_PASSWORD=your-database-password-here

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── SMTP ────────────────────────────────────────────────────────────────────────
# Full guide: docs/EMAIL_SMTP_SETUP.md
#
# For development, use MailHog (default). No credentials required.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false

# For REAL delivery with Gmail (free): requires 2-Step Verification + a
# Google App Password (NOT your normal Gmail password). Also set
# EMAIL_MODE=production below. NEVER commit the app password to Git.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your@gmail.com
# SMTP_PASSWORD=your-16-char-google-app-password
# SMTP_AUTH=true
# SMTP_TLS=true

# Optional SMTP tuning (sensible defaults applied if unset):
# SMTP_SSL_TRUST=            # e.g. smtp.gmail.com if the JVM trust store needs it
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_READ_TIMEOUT_MS=10000
# SMTP_WRITE_TIMEOUT_MS=10000

# ── Email ───────────────────────────────────────────────────────────────────────
# Set to 'production' to use real SMTP, 'development' to log to console.
# NOTE: when EMAIL_MODE=production AND SMTP_AUTH=true, the app validates at
# startup that SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD are set and fails fast
# with a clear error if any are missing.
EMAIL_MODE=development
# With Gmail, the actual From is forced to SMTP_USERNAME (Gmail rewrites it
# anyway); EMAIL_FROM_NAME is still used as the display name and the campaign's
# configured sender becomes the Reply-To.
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=MailFlow
EMAIL_RATE_LIMIT=100

# ── JWT ─────────────────────────────────────────────────────────────────────────
# IMPORTANT: Generate a secure random secret for production!
# Example: openssl rand -base64 64
JWT_SECRET=your-very-long-and-secure-jwt-secret-at-least-256-bits

# ── Batch ────────────────────────────────────────────────────────────────────────
BATCH_CHUNK_SIZE=50
BATCH_MAX_RETRIES=3
BATCH_SKIP_LIMIT=100
BATCH_THROTTLE_LIMIT=4

# ── AI Email Copilot ─────────────────────────────────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Application ──────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8080
SERVER_PORT=8080
UPLOAD_DIR=./uploads
MAX_ATTACHMENT_MB=10

# ── Deployment URLs ────────────────────────────────────────────────────────────
# BACKEND_URL  — public base URL of the API (used in docs / links).
# FRONTEND_URL — public URL(s) of the deployed frontend. Added to the backend
#                CORS allow-list. Comma-separated for multiple origins.
#                Local dev origins (3000/5173) are always allowed automatically.
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DEMO CREDENTIALS (change before any real deployment!)
# =============================================================================
# Admin:            admin@mailflow.local       / Admin@123
# Campaign Manager: manager@mailflow.local     / Manager@123
# Viewer:           viewer@mailflow.local      / Viewer@123
